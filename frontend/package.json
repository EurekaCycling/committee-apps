{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build:sw": "tsc -p tsconfig.sw.json",
    "dev": "npm run build:sw && vite",
    "build": "npm run build:sw && tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "cy:open": "op run --env-file=op_env -- cypress open --e2e --browser chrome",
    "cy:run": "NODE_NO_WARNINGS=1 op run --env-file=op_env -- cypress run --headed",
    "cy:video": "op run --env-file=op_env -- cypress run --spec cypress/e2e/walkthrough.cy.ts --no-runner-ui --browser chrome --headed"
  },
  "dependencies": {
    "@aws-amplify/ui-react": "^6.14.0",
    "aws-amplify": "^6.16.2",
    "classnames": "^2.5.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.1.1",
    "cypress": "^13.17.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "npm:rolldown-vite@7.2.5"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.2.5"
  }
}
